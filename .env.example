# .env.example — placeholder environment variables for local development and Vercel

# Turnstile (Cloudflare) keys
VITE_TURNSTILE_SITE_KEY=your_turnstile_site_key_here

# Web3Forms access key – **this key must remain server‑side only**
# (Do NOT expose it in any client‑side .env file)
# For local development you can leave it empty; the PHP script reads it from the
# server’s environment (e.g. /etc/environment or the web server config).
WEB3FORMS_ACCESS_KEY=your_web3forms_access_key_here

# API endpoint URL – used by the React app to POST form data
VITE_API_URL=https://api-syntaxis.rdec.ac.in/submit.php